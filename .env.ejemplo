# Copia este archivo a .env y rellena. El .env nunca va a git.

# Contraseña del PostgreSQL (la usa docker compose al crear la base de datos).
POSTGRES_PASSWORD=pon-aqui-una-contrasena-larga

# Dirección de la base de datos del mundo. Obligatoria: sin ella el servidor no arranca.
# En local (docker-compose.local.yml): puerto 5433 de este equipo.
ALDEA_BD_URL=postgresql+psycopg://aldea:pon-aqui-la-misma-contrasena@127.0.0.1:5433/aldea
# Sin Docker, vale SQLite:  ALDEA_BD_URL=sqlite:///datos-locales/aldea.sqlite

# Motor de IA: «simulado» (plantillas, sin coste; es el valor por defecto) o «claude» (API real, de pago).
ALDEA_MOTOR_IA=simulado

# Solo si ALDEA_MOTOR_IA=claude. Sin clave, el motor claude se niega a arrancar.
# ANTHROPIC_API_KEY=
